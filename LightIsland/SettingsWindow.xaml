<Window x:Class="LightIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico" Title="LightIsland Settings" Width="440" Height="780"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#000000" Foreground="White" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Small grey section title above a card -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F2F2F7" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="10,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,20">
            <TextBlock Text="Settings" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" />
            <TextBlock Text="Changes apply instantly." Foreground="#99EBEBF5" Margin="0,2,0,0" />

            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#0A84FF" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 3,5.5 H 11 V 8.5 H 3 Z" Fill="White" /></Grid>
                </Border>
                <TextBlock Text="Collapsed" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Width" Foreground="White" />
                            <TextBlock x:Name="CWv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="CW" Style="{StaticResource AppleSlider}" Minimum="150" Maximum="460"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Height" Foreground="White" />
                            <TextBlock x:Name="CHv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="CH" Style="{StaticResource AppleSlider}" Minimum="24" Maximum="60"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Bottom corners (0 = square)" Foreground="White" />
                            <TextBlock x:Name="CRv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="CR" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="40"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Text size (time, weather, song)" Foreground="White" />
                            <TextBlock x:Name="TSv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="TS" Style="{StaticResource AppleSlider}" Minimum="60" Maximum="220"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#5E5CE6" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 2.5,3 H 11.5 V 11 H 2.5 Z" Fill="White" /></Grid>
                </Border>
                <TextBlock Text="Expanded (opens on click)" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Width" Foreground="White" />
                            <TextBlock x:Name="EWv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="EW" Style="{StaticResource AppleSlider}" Minimum="380" Maximum="640"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Height" Foreground="White" />
                            <TextBlock x:Name="EHv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="EH" Style="{StaticResource AppleSlider}" Minimum="165" Maximum="280"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Bottom corners (0 = square)" Foreground="White" />
                            <TextBlock x:Name="ERv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="ER" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="50"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#BF5AF2" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 7,2 A 5,5 0 1 1 6.99,2 Z" Fill="White" /></Grid>
                </Border>
                <TextBlock Text="Shape" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel x:Name="TRPanel" Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Notch top curve (0 = none)" Foreground="White" />
                            <TextBlock x:Name="TRv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="TR" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="24"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                    <Border x:Name="TRDiv" Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,12,14,8">
                        <TextBlock Text="Style" Foreground="White" />
                        <WrapPanel x:Name="ShapePills" Margin="0,10,0,0" />
                    </StackPanel>
                    <Border x:Name="TGDiv" Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel x:Name="TGPanel" Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Gap from the screen top (island style)" Foreground="White" />
                            <TextBlock x:Name="TGv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="TG" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="30"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#32ADE6" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 7,2 A 5,5 0 0 0 7,12 Z" Fill="White" /><Path Data="M 7,2 A 5,5 0 0 1 7,12" Stroke="White" StrokeThickness="1.3" /></Grid>
                </Border>
                <TextBlock Text="Theme and glass" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="14,12,14,8">
                        <TextBlock Text="Mode" Foreground="White" />
                        <WrapPanel x:Name="ThemePills" Margin="0,10,0,0" />
                        <TextBlock Text="Sets the island and text colors. You can still change them below."
                                   Foreground="#99EBEBF5" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <TextBlock Text="Liquid Glass" Foreground="White" VerticalAlignment="Center" />
                        <CheckBox x:Name="GlassCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Glass_Changed" Unchecked="Glass_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Glass opacity (lower = more see-through)" Foreground="White" />
                            <TextBlock x:Name="GOv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="GO" Style="{StaticResource AppleSlider}" Minimum="10" Maximum="100"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#FF375F" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 7,1.8 C 7,1.8 11.4,6 11.4,8.6 A 4.4,4.4 0 0 1 2.6,8.6 C 2.6,6 7,1.8 7,1.8 Z" Fill="White" /></Grid>
                </Border>
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="14,12,14,6">
                        <TextBlock Text="Island color" Foreground="White" />
                        <WrapPanel x:Name="Swatches" Margin="0,10,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,8">
                        <TextBlock Text="Hex color" Foreground="White" VerticalAlignment="Center" />
                        <TextBox x:Name="HexBox" Style="{StaticResource Field}" Width="110" MaxLength="7"
                                 HorizontalAlignment="Right" TextChanged="Hex_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Transparency (when Glass is off)" Foreground="White" />
                            <TextBlock x:Name="BOv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="BO" Style="{StaticResource AppleSlider}" Minimum="20" Maximum="100"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,12,14,6">
                        <TextBlock Text="Text color" Foreground="White" />
                        <WrapPanel x:Name="TextSwatches" Margin="0,10,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,8">
                        <TextBlock Text="Text hex color" Foreground="White" VerticalAlignment="Center" />
                        <TextBox x:Name="TextHexBox" Style="{StaticResource Field}" Width="110" MaxLength="7"
                                 HorizontalAlignment="Right" TextChanged="TextHex_Changed" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#FF9F0A" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 7,2 A 5,5 0 1 1 6.99,2 Z" Stroke="White" StrokeThickness="1.4" /><Path Data="M 5,6 A 0.8,0.8 0 1 1 4.99,6 Z M 9,6 A 0.8,0.8 0 1 1 8.99,6 Z M 7,9 A 0.8,0.8 0 1 1 6.99,9 Z" Fill="White" /></Grid>
                </Border>
                <TextBlock Text="Colors" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="14,12,14,6">
                        <TextBlock Text="Equalizer color (default green)" Foreground="White" />
                        <WrapPanel x:Name="EqSwatches" Margin="0,10,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,8">
                        <TextBlock Text="Equalizer hex color" Foreground="White" VerticalAlignment="Center" />
                        <TextBox x:Name="EqHexBox" Style="{StaticResource Field}" Width="110" MaxLength="7"
                                 HorizontalAlignment="Right" TextChanged="EqHex_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,12,14,6">
                        <TextBlock Text="Accent color (calendar, weather, system bars)" Foreground="White" />
                        <WrapPanel x:Name="AccSwatches" Margin="0,10,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,8">
                        <TextBlock Text="Accent hex color" Foreground="White" VerticalAlignment="Center" />
                        <TextBox x:Name="AccHexBox" Style="{StaticResource Field}" Width="110" MaxLength="7"
                                 HorizontalAlignment="Right" TextChanged="AccHex_Changed" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#30D158" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 4.8,3 L 11,7 L 4.8,11 Z" Fill="White" StrokeLineJoin="Round" Stroke="White" StrokeThickness="1" /></Grid>
                </Border>
                <TextBlock Text="Animation" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="14,12,14,8">
                        <TextBlock Text="Style" Foreground="White" />
                        <WrapPanel x:Name="AnimStyles" Margin="0,10,0,0" />
                        <TextBlock x:Name="AnimDesc" Foreground="#99EBEBF5" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,2,0,2" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <StackPanel Margin="14,10,14,8">
                        <Grid>
                            <TextBlock Text="Speed" Foreground="White" />
                            <TextBlock x:Name="ASv" HorizontalAlignment="Right" Foreground="#99EBEBF5" />
                        </Grid>
                        <Slider x:Name="AS" Style="{StaticResource AppleSlider}" Minimum="0.4" Maximum="3"
                                IsMoveToPointEnabled="True" Margin="0,4,0,0" ValueChanged="Slider_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#64D2FF" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 7,4 A 3,3 0 1 1 6.99,4 Z" Fill="White" /><Path Data="M 7,0.8 V 1.9 M 7,12.1 V 13.2 M 0.8,7 H 1.9 M 12.1,7 H 13.2" Stroke="White" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Grid>
                </Border>
                <TextBlock Text="Weather" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="14,9">
                        <TextBlock Text="Temperature in Fahrenheit" Foreground="White" VerticalAlignment="Center" />
                        <CheckBox x:Name="FahrCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Weather_Changed" Unchecked="Weather_Changed" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="6,24,0,10">
                <Border Width="26" Height="26" CornerRadius="8" Background="#8E8E93" BorderBrush="#66FFFFFF" BorderThickness="0.8">
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 2.5,4 H 11.5 M 2.5,7 H 11.5 M 2.5,10 H 11.5" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Grid>
                </Border>
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="14,9">
                        <TextBlock Text="24-hour time" Foreground="White" VerticalAlignment="Center" />
                        <CheckBox x:Name="Hour24Check" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Hour24_Changed" Unchecked="Hour24_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="File ring key" Foreground="White" />
                            <TextBlock Text="Select a file, hold this key: the ring opens. Let go: it closes." Foreground="#99EBEBF5" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border x:Name="RingKeyBtn" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="64" CornerRadius="9"
                                Padding="12,5" Background="#2C2C2E" Cursor="Hand" ToolTip="Click, then press the key you want"
                                MouseLeftButtonUp="RingKey_Click">
                            <TextBlock x:Name="RingKeyText" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Favorite apps ring" Foreground="White" />
                            <TextBlock Text="Hold the apps key: a ring of your apps opens. Let go on an app to open it." Foreground="#99EBEBF5" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                        <CheckBox x:Name="AppsCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Apps_Changed" Unchecked="Apps_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Apps key" Foreground="White" />
                            <TextBlock Text="Caps Lock, Ctrl, Alt or an F-key work best (a letter key stops typing that letter)." Foreground="#99EBEBF5" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                        <Border x:Name="AppsKeyBtn" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="64" CornerRadius="9"
                                Padding="12,5" Background="#2C2C2E" Cursor="Hand" ToolTip="Click, then press the key you want"
                                MouseLeftButtonUp="AppsKey_Click">
                            <TextBlock x:Name="AppsKeyText" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Record animation timing" Foreground="White" />
                            <TextBlock Text="For fixing lag: writes %AppData%\LightIsland\perf.log" Foreground="#99EBEBF5" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="PerfCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Perf_Changed" Unchecked="Perf_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Music edge glow" Foreground="White" />
                            <TextBlock Text="A soft light around the screen edges in the colors of the song. Moves with the music." Foreground="#99EBEBF5" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                        <CheckBox x:Name="FxEdgeCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Fx_Changed" Unchecked="Fx_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Music wallpaper" Foreground="White" />
                            <TextBlock Text="Your desktop becomes the song: album colors, cover and live lyrics. Needs the live video wallpaper to be off. RAM limit becomes 100 MB while it runs." Foreground="#99EBEBF5" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                        <CheckBox x:Name="FxWallCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Fx_Changed" Unchecked="Fx_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lyrics on the wallpaper" Foreground="White" />
                            <TextBlock Text="Synced lyrics from LRCLIB (online). Nothing is shown when a song has none." Foreground="#99EBEBF5" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                        <CheckBox x:Name="FxLyricsCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Fx_Changed" Unchecked="Fx_Changed" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="16,0,0,0" />
                    <Grid Margin="14,9">
                        <TextBlock Text="Start with Windows" Foreground="White" VerticalAlignment="Center" />
                        <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  Checked="Startup_Changed" Unchecked="Startup_Changed" />
                    </Grid>
                </StackPanel>
            </Border>
            <Button Content="Reset to defaults" Style="{StaticResource RowButton}" Margin="0,22,0,0"
                    Click="Reset_Click" />

            <StackPanel Margin="0,24,0,4">
                <TextBlock Text="LightIsland v1.2" HorizontalAlignment="Center" Foreground="#99EBEBF5" FontSize="12" />
                <TextBlock Text="Made by NOBODY" HorizontalAlignment="Center" Foreground="#636366"
                           FontSize="11" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Border x:Name="DiscordBtn" Width="42" Height="42" CornerRadius="21" Margin="7,0" Cursor="Hand"
                            Style="{StaticResource GlassCircle}" ToolTip="Discord: bugs, feature ideas" MouseLeftButtonUp="Discord_Click">
                        <Path Width="24" Height="24" Stretch="None" Fill="#E5E5EA" IsHitTestVisible="False"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="F0 M19.3,5.4 A16.5,16.5 0 0 0 15.2,4.1 L14.7,5.1 A15.3,15.3 0 0 0 9.3,5.1 L8.8,4.1 A16.5,16.5 0 0 0 4.7,5.4 C2.1,9.3 1.4,13.1 1.7,16.9 A16.6,16.6 0 0 0 6.7,19.4 L7.8,17.6 A10.8,10.8 0 0 1 6.1,16.8 L6.5,16.5 A11.8,11.8 0 0 0 16.7,16.5 L17.1,16.8 C16.6,17.1 16,17.4 15.4,17.6 L16.5,19.4 A16.6,16.6 0 0 0 21.5,16.9 C21.9,12.5 20.8,8.7 19.3,5.4 Z M7.5,12.2 A1.6,1.6 0 1 1 10.7,12.2 A1.6,1.6 0 1 1 7.5,12.2 Z M13.3,12.2 A1.6,1.6 0 1 1 16.5,12.2 A1.6,1.6 0 1 1 13.3,12.2 Z" />
                    </Border>
                    <Border x:Name="InstaBtn" Width="42" Height="42" CornerRadius="21" Margin="7,0" Cursor="Hand"
                            Style="{StaticResource GlassCircle}" ToolTip="Instagram: bugs, feature ideas" MouseLeftButtonUp="Insta_Click">
                        <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Rectangle Width="17" Height="17" RadiusX="5" RadiusY="5" Stroke="#E5E5EA" StrokeThickness="1.8" />
                            <Ellipse Width="7.5" Height="7.5" Stroke="#E5E5EA" StrokeThickness="1.8" />
                            <Ellipse Width="2" Height="2" Fill="#E5E5EA" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5.2,5.2,0" />
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock Text="Found a bug or want a feature? Tap an icon and message me."
                           HorizontalAlignment="Center" Foreground="#636366" FontSize="11" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
