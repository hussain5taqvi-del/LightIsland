<Window x:Class="LightIsland.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico" Title="LightIsland Wallpapers" Width="1020" Height="720" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#000000" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: tabs + search -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassPill}" VerticalAlignment="Center" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabWalls" Style="{StaticResource Seg}" Content="Wallpapers" GroupName="tabs"
                                 IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabLib" Style="{StaticResource Seg}" Content="My library" GroupName="tabs"
                                 Checked="Tab_Checked" />
                </StackPanel>
            </Border>

        </Grid>

        <!-- Categories (same as 4kwallpapers.com). Scroll sideways with the mouse wheel. -->
        <ScrollViewer x:Name="ChipsHost" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Hidden" PreviewMouseWheel="Chips_Wheel">
            <StackPanel x:Name="Chips" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- Wallpaper cards -->
        <Grid Grid.Row="2" Margin="-6,14,-6,0">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="Scroll_SizeChanged">
                <UniformGrid x:Name="Cards" Columns="4" VerticalAlignment="Top" Margin="0,0,4,0" />
            </ScrollViewer>
            <TextBlock x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}" FontSize="14" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="480" />
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Pager" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevBtn" Style="{StaticResource IconBtn}" Click="Prev_Click">
                    <Path Data="M 6,0 L 0,6 L 6,12" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,2,0" />
                </Button>
                <TextBlock x:Name="PageLabel" Margin="14,0" VerticalAlignment="Center" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" Text="Page 1" />
                <Button x:Name="NextBtn" Style="{StaticResource IconBtn}" Click="Next_Click">
                    <Path Data="M 0,0 L 6,6 L 0,12" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="2,0,0,0" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddBtn" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 6,0 V 12 M 0,6 H 12" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Add picture" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="FolderBtn" Style="{StaticResource Btn}" Click="Folder_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0.8,2.5 H 5.2 L 6.8,4.2 H 13.2 V 11.5 H 0.8 Z" Stroke="White" StrokeThickness="1.5"
                              StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Open folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
