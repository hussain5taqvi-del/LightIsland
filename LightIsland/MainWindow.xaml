<Window x:Class="LightIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightIsland" Width="460" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Text colors (replaced from code when the user changes the text color) -->
        <SolidColorBrush x:Key="TextBrush" Color="White" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#99FFFFFF" />
        <!-- Theme brushes (replaced from code for Light mode) -->
        <SolidColorBrush x:Key="TrackBrush" Color="#2E2E30" />
        <SolidColorBrush x:Key="TileBg" Color="#262628" />
        <SolidColorBrush x:Key="TileStroke" Color="#00FFFFFF" />
        <SolidColorBrush x:Key="EqBrush" Color="#30D158" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="FillBrush" Color="#E6E6E6" />
        <!-- Glass rim: bright thin edge that is strongest at the bottom corners -->
        <LinearGradientBrush x:Key="RimBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B0FFFFFF" Offset="0" />
            <GradientStop Color="#14FFFFFF" Offset="0.38" />
            <GradientStop Color="#14FFFFFF" Offset="0.62" />
            <GradientStop Color="#B0FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BtnHoverBrush" Color="#22FFFFFF" />

        <!-- Premium vector icons (24 x 24) -->
        <Geometry x:Key="PlayGeo">M7,4.8 C7,3.9 8,3.4 8.8,3.9 L19.2,10.9 C19.9,11.4 19.9,12.6 19.2,13.1 L8.8,20.1 C8,20.6 7,20.1 7,19.2 Z</Geometry>
        <Geometry x:Key="PauseGeo">M7,4 H8.5 A1.5,1.5 0 0 1 10,5.5 V18.5 A1.5,1.5 0 0 1 8.5,20 H7 A1.5,1.5 0 0 1 5.5,18.5 V5.5 A1.5,1.5 0 0 1 7,4 Z M15.5,4 H17 A1.5,1.5 0 0 1 18.5,5.5 V18.5 A1.5,1.5 0 0 1 17,20 H15.5 A1.5,1.5 0 0 1 14,18.5 V5.5 A1.5,1.5 0 0 1 15.5,4 Z</Geometry>
        <Geometry x:Key="NextGeo">M3,6.2 L11,12 L3,17.8 Z M13,6.2 L21,12 L13,17.8 Z</Geometry>
        <Geometry x:Key="PrevGeo">M21,6.2 L13,12 L21,17.8 Z M11,6.2 L3,12 L11,17.8 Z</Geometry>

        <!-- Round media button: soft hover circle, springy press -->
        <Style x:Key="MediaBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                            <Ellipse x:Name="Hv" Fill="{DynamicResource BtnHoverBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hv" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hv" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.84" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.84" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.1" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.1" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Media buttons (old text style, kept for reference) -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Margin" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small icon buttons (settings gear, add, refresh, clear) -->
        <Style x:Key="Gear" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Page heading -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Empty-state text -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Notch: the island plus two small "ears" that curve into the top edge of the screen -->
        <Grid x:Name="NotchHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0"
              UseLayoutRounding="False" SnapsToDevicePixels="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IslandShift" Y="0" />
            </Grid.RenderTransform>


        <Grid x:Name="IslandWrap">
        <Border x:Name="Island"
                Width="280" Height="36" CornerRadius="0,0,18,18"
                Background="Black"
                ClipToBounds="True" AllowDrop="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_Click"
                PreviewMouseWheel="Island_PreviewMouseWheel"
                DragEnter="Island_DragEnter" DragOver="Island_DragOver"
                DragLeave="Island_DragLeave" Drop="Island_Drop">

            <Grid>
                <!-- Liquid Glass layers (hidden unless Glass is on): soft top light, moving shine -->
                <Border x:Name="GlassGloss" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Island}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3CFFFFFF" Offset="0" />
                            <GradientStop Color="#0CFFFFFF" Offset="0.4" />
                            <GradientStop Color="#00FFFFFF" Offset="0.72" />
                            <GradientStop Color="#18FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <!-- soft light spot, like light catching the glass -->
                    <Border CornerRadius="{Binding CornerRadius, ElementName=Island}">
                        <Border.Background>
                            <RadialGradientBrush Center="0.18,0" GradientOrigin="0.18,0" RadiusX="0.55" RadiusY="0.9">
                                <GradientStop Color="#26FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
                <Border x:Name="GlassSheen" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Island}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                            <GradientStop x:Name="SheenA" Color="#00FFFFFF" Offset="-0.3" />
                            <GradientStop x:Name="SheenB" Color="#66FFFFFF" Offset="-0.1" />
                            <GradientStop x:Name="SheenC" Color="#00FFFFFF" Offset="0.1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Collapsed state (notch): art on the left, song name or time in the middle, equalizer + battery on the right -->
                <Grid x:Name="Compact" UseLayoutRounding="True" Margin="0,0,0,2" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="CompactScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ArtSmall" Width="22" Height="22" CornerRadius="6" Background="#2A2A2A"
                            Margin="16,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />

                    <!-- Idle (no music): time | weather. Two equal halves, so the divider is exactly in the middle -->
                    <Grid x:Name="IdlePanel" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="IdleCol0" Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="IdleCol2" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeText" Foreground="{DynamicResource TextBrush}" FontSize="16"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="IdleDivider" Grid.Column="1" Width="1" Height="18" Opacity="0.35"
                                Background="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        <StackPanel x:Name="WxBox" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Path x:Name="WxIconSmall" Width="24" Height="24" Stretch="None"
                                      Fill="{DynamicResource AccentBrush}" />
                            </Viewbox>
                            <TextBlock x:Name="WxTemp" Foreground="{DynamicResource TextBrush}" FontSize="16"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Song name: replaces the time while music plays -->
                    <TextBlock x:Name="SongText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="13"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

                    <StackPanel x:Name="RightCluster" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="8,0,16,0">
                        <!-- Equalizer (color from Settings, only while music plays) -->
                        <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center"
                                    Height="14" Margin="0,0,10,0" Visibility="Collapsed">
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource EqBrush}"
                                       Margin="1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="B1" ScaleY="0.25" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource EqBrush}"
                                       Margin="1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="B2" ScaleY="0.25" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource EqBrush}"
                                       Margin="1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="B3" ScaleY="0.25" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource EqBrush}"
                                       Margin="1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="B4" ScaleY="0.25" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </StackPanel>

                    <!-- Privacy dots (vertical, far right): green = camera in use, orange = microphone in use -->
                    <StackPanel x:Name="PrivBox" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,13,0" Visibility="Collapsed">
                        <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#30D158" Margin="0,1.5"
                                 Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="CamScale" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Margin="0,1.5"
                                 Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="MicScale" /></Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                </Grid>

                <!-- Activity bar (volume, brightness, Bluetooth): replaces the collapsed content for a moment -->
                <Grid x:Name="Hud" UseLayoutRounding="True" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                      Margin="0,0,0,2" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="HudScale" ScaleX="0.9" ScaleY="0.9" /></Grid.RenderTransform>
                    <TextBlock x:Name="HudIcon" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock x:Name="HudLabel" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left"
                               VerticalAlignment="Center" Margin="44,0,0,0" MaxWidth="170"
                               TextTrimming="CharacterEllipsis" />
                    <Grid x:Name="HudBarHost" Width="96" Height="5" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border CornerRadius="2.5" Background="{DynamicResource TextBrush}" Opacity="0.25" />
                        <Border x:Name="HudFill" CornerRadius="2.5" Background="{DynamicResource TextBrush}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <TextBlock x:Name="HudValue" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" />
                </Grid>

                <!-- Expanded state: pages + page dots -->
                <Grid x:Name="Expanded" UseLayoutRounding="True" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ExpandedScale" ScaleX="0.97" ScaleY="0.97" />
                            <TranslateTransform x:Name="ExpandedShift" Y="8" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <!-- Everything inside scales with the island (the island size sets the content size) -->
                    <Viewbox Stretch="Fill">
                    <Grid x:Name="ExpandedInner" Width="396" Height="174">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="Pages" ClipToBounds="True">

                        <!-- Page 1: Media -->
                        <Grid x:Name="PageMedia">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Album art + title, centered as one group -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="ArtBig" Width="54" Height="54" CornerRadius="13"
                                        Background="#2A2A2A" VerticalAlignment="Center" />
                                <StackPanel x:Name="TitleBox" Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="260">
                                    <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextBrush}" FontSize="16"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Text="Nothing playing" />
                                    <TextBlock x:Name="ArtistText" Foreground="{DynamicResource TextDimBrush}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Seek bar: click or drag to jump forward/back in the song -->
                            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />

                                <Grid x:Name="SeekHost" Grid.Column="1" Height="20" Background="Transparent"
                                      Cursor="Hand" Opacity="0.3"
                                      MouseEnter="Seek_Enter" MouseLeave="Seek_Leave"
                                      MouseLeftButtonDown="Seek_Down" MouseMove="Seek_Move" MouseLeftButtonUp="Seek_Up">
                                    <Grid x:Name="SeekVisual" Height="5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><ScaleTransform x:Name="SeekGrow" ScaleY="1" /></Grid.RenderTransform>
                                        <Border CornerRadius="2.5" Background="{DynamicResource TrackBrush}" />
                                        <Border x:Name="SeekFill" CornerRadius="2.5" Background="{DynamicResource FillBrush}"
                                                HorizontalAlignment="Left" Width="0" />
                                    </Grid>
                                </Grid>

                                <TextBlock x:Name="TotalText" Grid.Column="2" Text="0:00" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>

                            <!-- Controls: previous | play / pause | next -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource MediaBtn}" Click="Prev_Click" ToolTip="Previous">
                                    <Viewbox Width="26" Height="26">
                                        <Path Width="24" Height="24" Stretch="None" Data="{StaticResource PrevGeo}"
                                              Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource TextBrush}"
                                              StrokeThickness="1.6" StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="PlayBtn" Style="{StaticResource MediaBtn}" Width="54" Height="54" Click="PlayPause_Click" ToolTip="Play / Pause">
                                    <Viewbox Width="34" Height="34">
                                        <Path x:Name="PlayIcon" Width="24" Height="24" Stretch="None" Data="{StaticResource PlayGeo}"
                                              Fill="{DynamicResource TextBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><ScaleTransform x:Name="PlayIconScale" /></Path.RenderTransform>
                                        </Path>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource MediaBtn}" Click="Next_Click" ToolTip="Next">
                                    <Viewbox Width="26" Height="26">
                                        <Path Width="24" Height="24" Stretch="None" Data="{StaticResource NextGeo}"
                                              Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource TextBrush}"
                                              StrokeThickness="1.6" StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Page 2: Favorite apps -->
                        <Grid x:Name="PageApps" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,6" Height="20">
                                <TextBlock x:Name="AppsTitle" Text="Favorite apps" Style="{StaticResource PageTitle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppsEditBtn" Text="Edit" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                                               ToolTip="Remove or rearrange apps" MouseLeftButtonUp="AppsEdit_Click" />
                                    <TextBlock Style="{StaticResource Gear}" Text="&#xE710;" ToolTip="Add app"
                                               VerticalAlignment="Center" MouseLeftButtonUp="AddApp_Click" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="AppsPanel" Margin="0,7,7,0" />
                            </ScrollViewer>
                            <TextBlock x:Name="AppsHint" Grid.Row="1" Style="{StaticResource Hint}"
                                       Text="Click + or drop an app here" />
                        </Grid>

                        <!-- Page 5: Clock (time and date) -->
                        <Grid x:Name="PageClock" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="ClockBig" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="ClockDate" FontSize="13" Foreground="{DynamicResource TextDimBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Page 6: Calendar -->
                        <Grid x:Name="PageCal" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="12" Margin="0,0,14,0">
                                <Grid Margin="8,9,8,9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="CalMonth" Foreground="{DynamicResource AccentBrush}" FontSize="14"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="CalYear" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="CalDayBig" Grid.Row="1" FontSize="48" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CalWeekday" Grid.Row="2" Foreground="{DynamicResource TextDimBrush}"
                                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border x:Name="CalHost" Grid.Column="1" VerticalAlignment="Stretch" />
                        </Grid>

                        <!-- Page 7: Weather -->
                        <Grid x:Name="PageWx" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <Grid x:Name="WxContent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="4,2,10,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="WxCity" Foreground="{DynamicResource TextDimBrush}" FontSize="12.5"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <Viewbox Width="40" Height="40" VerticalAlignment="Center">
                                            <Path x:Name="WxIconBig" Width="24" Height="24" Stretch="None"
                                                  Fill="{DynamicResource AccentBrush}" />
                                        </Viewbox>
                                        <TextBlock x:Name="WxBigTemp" Foreground="{DynamicResource TextBrush}" FontSize="42"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="WxCond" Grid.Row="2" Foreground="{DynamicResource TextBrush}" FontSize="14"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Border Grid.Column="1" Width="1" Background="{DynamicResource TextDimBrush}" Opacity="0.35"
                                        Margin="0,6" />
                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Width="168">
                                    <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Padding="11,5" Margin="0,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="Wind" Foreground="{DynamicResource TextDimBrush}" FontSize="11" />
                                            <TextBlock x:Name="WxWind" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Padding="11,5" Margin="0,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="Feels like" Foreground="{DynamicResource TextDimBrush}" FontSize="11" />
                                            <TextBlock x:Name="WxFeels" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Padding="11,5">
                                        <StackPanel>
                                            <TextBlock Text="Humidity" Foreground="{DynamicResource TextDimBrush}" FontSize="11" />
                                            <TextBlock x:Name="WxHum" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Viewbox>
                            </Grid>
                            <TextBlock x:Name="WxHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                                       Text="Weather is not available right now.&#10;Check your internet connection or the city in Settings." />
                        </Grid>

                        <!-- Page 8: System (real numbers, only measured while this page is open) -->
                        <Grid x:Name="PageSys" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <UniformGrid Columns="3" Rows="2">
                            <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Margin="3">
                                <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="4,3">
                                    <Grid Width="108" Height="72">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="CPU" Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysCpuV" Grid.Row="1" Text="…" Foreground="{DynamicResource TextBrush}" FontSize="19"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysCpuS" Grid.Row="2" Text=" " Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Grid Grid.Row="3" Height="3" Margin="12,0" VerticalAlignment="Center">
                                        <Border CornerRadius="1.5" Background="{DynamicResource TrackBrush}" />
                                        <Border CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="SysCpuSc" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Margin="3">
                                <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="4,3">
                                    <Grid Width="108" Height="72">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="RAM" Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysRamV" Grid.Row="1" Text="…" Foreground="{DynamicResource TextBrush}" FontSize="19"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysRamS" Grid.Row="2" Text=" " Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Grid Grid.Row="3" Height="3" Margin="12,0" VerticalAlignment="Center">
                                        <Border CornerRadius="1.5" Background="{DynamicResource TrackBrush}" />
                                        <Border CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="SysRamSc" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Margin="3">
                                <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="4,3">
                                    <Grid Width="108" Height="72">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="STORAGE" Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysDskV" Grid.Row="1" Text="…" Foreground="{DynamicResource TextBrush}" FontSize="19"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysDskS" Grid.Row="2" Text=" " Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Grid Grid.Row="3" Height="3" Margin="12,0" VerticalAlignment="Center">
                                        <Border CornerRadius="1.5" Background="{DynamicResource TrackBrush}" />
                                        <Border CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="SysDskSc" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Margin="3">
                                <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="4,3">
                                    <Grid Width="108" Height="72">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="GPU" Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysGpuV" Grid.Row="1" Text="…" Foreground="{DynamicResource TextBrush}" FontSize="19"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysGpuS" Grid.Row="2" Text=" " Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Grid Grid.Row="3" Height="3" Margin="12,0" VerticalAlignment="Center">
                                        <Border CornerRadius="1.5" Background="{DynamicResource TrackBrush}" />
                                        <Border CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="SysGpuSc" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Margin="3">
                                <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="4,3">
                                    <Grid Width="108" Height="72">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="NETWORK" Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysNetV" Grid.Row="1" Text="…" Foreground="{DynamicResource TextBrush}" FontSize="15"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SysNetS" Grid.Row="2" Text=" " Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Grid Grid.Row="3" Height="3" Margin="12,0" VerticalAlignment="Center" Visibility="Hidden">
                                        <Border CornerRadius="1.5" Background="{DynamicResource TrackBrush}" />
                                        <Border CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="SysNetSc" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <Border Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" CornerRadius="10" Margin="3">
                                <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="4,3">
                                    <Grid Width="108" Height="72">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="SPEED TEST" Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SpdV" Grid.Row="1" Text="&#x2014;" Foreground="{DynamicResource TextBrush}" FontSize="17"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SpdS" Grid.Row="2" Text="Internet speed" Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border x:Name="SpdBtn" Grid.Row="3" Background="{DynamicResource AccentBrush}" CornerRadius="8" Height="16" Width="56"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Speed_Click">
                                            <TextBlock x:Name="SpdBtnText" Text="Start" Foreground="#101012" FontSize="10"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            </UniformGrid>
                        </Grid>
                    </Grid>

                    <!-- Page dots -->
                    <StackPanel x:Name="Dots" Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Height="10" Margin="0,4,0,0" />
                    </Grid>
                    </Viewbox>
                </Grid>

                <!-- Liquid Glass rim: thin bright edge (not on the top, where the notch touches the screen) -->
                <Border x:Name="GlassRim" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        BorderThickness="1.4,0,1.4,1.4" BorderBrush="{DynamicResource RimBrush}" />
            </Grid>
        </Border>
        </Grid>
            <Path x:Name="EarL" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="Black" IsHitTestVisible="False" />
            <Path x:Name="EarR" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Fill="Black" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
